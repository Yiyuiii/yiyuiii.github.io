{% assign lang_key = page.lang | default: 'zh' %}
{% if lang_key == 'zh-CN' %}{% assign lang_key = 'zh' %}{% endif %}
{% assign quiz = site.data.acg_relation_quiz %}
{% assign copy = quiz.copy[lang_key] | default: quiz.copy.zh %}
{% assign source_copy = quiz.source_copy[lang_key] | default: quiz.source_copy.en %}
{% assign heading_id = include.heading_id | default: 'acg-relation-quiz-title' %}
{% capture privacy_id %}{{ heading_id }}-privacy{% endcapture %}

<div class="acg-relation-quiz" data-acg-relation-quiz aria-labelledby="{{ heading_id | escape }}">
  <div data-acg-enhanced hidden>
    <p class="acg-relation-quiz__source-label">{{ copy.source_label }}</p>

    <p id="{{ privacy_id | escape }}" class="acg-relation-quiz__privacy" data-acg-privacy>
      {{ source_copy.privacy }}
    </p>

    <div data-acg-interactive hidden>
      <button class="acg-relation-quiz__start" type="button" data-acg-start>{{ copy.start }}</button>

      <div class="acg-relation-quiz__round" data-acg-round hidden>
        <p class="acg-relation-quiz__prompt" data-acg-prompt tabindex="-1"></p>
        <div
          class="acg-relation-quiz__options"
          data-acg-options
          role="group"
          aria-label="{{ copy.options_label | escape }}"
        ></div>
      </div>

      <p class="acg-relation-quiz__status" data-acg-status aria-live="polite" aria-atomic="true"></p>

      <div class="acg-relation-quiz__source" data-acg-source hidden>
        <a
          data-acg-source-link
          target="_blank"
          rel="external nofollow noopener noreferrer"
          referrerpolicy="no-referrer"
        ></a>
        <p data-acg-attribution>{{ source_copy.attribution }}</p>
        <a
          data-acg-terms-link
          href="{{ quiz.source.terms_url | escape }}"
          target="_blank"
          rel="external nofollow noopener noreferrer"
          referrerpolicy="no-referrer"
        >{{ source_copy.terms_label }}</a>
      </div>
    </div>
  </div>

  <noscript><p class="acg-relation-quiz__noscript">{{ copy.no_js }}</p></noscript>

  <script type="application/json" data-acg-config>
    {
      "page_lang": {{ lang_key | jsonify }},
      "timeout_ms": {{ quiz.timeout_ms | jsonify }},
      "max_response_chars": {{ quiz.max_response_chars | jsonify }},
      "recent_history_size": {{ quiz.recent_history_size | jsonify }},
      "source": {{ quiz.source | jsonify }},
      "copy": {{ copy | jsonify }},
      "source_copy": {{ source_copy | jsonify }}
    }
  </script>
  <script src="{{ '/assets/js/acg-relation-quiz-logic.js' | relative_url | bust_file_cache }}" defer></script>
  <script src="{{ '/assets/js/acg-relation-quiz.js' | relative_url | bust_file_cache }}" defer></script>
</div>
