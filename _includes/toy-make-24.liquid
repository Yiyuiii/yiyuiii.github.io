<section class="toy-challenge toy-make-24" data-toy-make-24 aria-label="{{ challenge_label | escape }}">
  <p class="toy-challenge__instructions">{{ instructions }}</p>
  <p class="toy-challenge__note">{{ disclaimer }}</p>

  <div class="toy-challenge__interactive" data-challenge-interactive data-make24-interactive hidden>
    <details class="toy-settings toy-make-24-settings" data-make24-settings>
      <summary>
        <span class="toy-settings__title">{{ settings_title }}</span>
        <span class="toy-settings__summary" data-make24-settings-summary></span>
        <span class="toy-settings__adjust">{{ settings_adjust }}</span>
      </summary>
      <div class="toy-settings__panel">
        <label class="toy-settings__field" for="make24-pool">
          <span>{{ pool_label }}</span>
          <select id="make24-pool" data-make24-pool>
            <option value="integer">{{ pool_integer }}</option>
            <option value="fraction">{{ pool_fraction }}</option>
            <option value="all">{{ pool_all }}</option>
          </select>
        </label>
        <output class="toy-settings__candidate" for="make24-pool" data-make24-pool-count></output>
        <p class="toy-settings__notice">{{ settings_notice }}</p>
        <div class="toy-settings__actions">
          <button type="button" data-make24-settings-reset>{{ settings_reset }}</button>
          <button type="button" class="toy-settings__apply" data-make24-settings-apply>{{ settings_apply }}</button>
        </div>
        <p class="toy-settings__status" data-make24-settings-status aria-live="polite" aria-atomic="true"></p>
      </div>
    </details>

    <p id="make24-prompt" class="toy-make-24__prompt" data-make24-prompt aria-live="polite" aria-atomic="true"></p>
    <div class="toy-make-24__values" data-make24-values role="group" aria-label="{{ values_label | escape }}" aria-describedby="make24-prompt"></div>
    <div class="toy-make-24__operators" data-make24-operators role="group" aria-label="{{ operators_label | escape }}">
      <button type="button" data-make24-operator="+" aria-pressed="false" aria-label="{{ add_label }}">+</button>
      <button type="button" data-make24-operator="-" aria-pressed="false" aria-label="{{ subtract_label }}">−</button>
      <button type="button" data-make24-operator="*" aria-pressed="false" aria-label="{{ multiply_label }}">×</button>
      <button type="button" data-make24-operator="/" aria-pressed="false" aria-label="{{ divide_label }}">÷</button>
    </div>

    <div class="toy-make-24__steps" data-make24-steps hidden>
      <p>{{ steps_label }}</p>
      <ol data-make24-step-list></ol>
    </div>

    <div class="toy-make-24__steps toy-make-24__answer" data-make24-answer tabindex="-1" hidden>
      <p>{{ answer_label }}</p>
      <ol data-make24-answer-list></ol>
    </div>

    <div class="toy-challenge__actions toy-make-24__actions">
      <button type="button" data-make24-undo>{{ undo_label }}</button>
      <button type="button" data-make24-reveal>{{ reveal_label }}</button>
      <button type="button" data-make24-reset>{{ reset_label }}</button>
      <button type="button" data-make24-new>{{ new_label }}</button>
    </div>
    <p class="toy-challenge__status" data-make24-status aria-live="polite" aria-atomic="true"></p>
  </div>

  <p class="toy-challenge__unavailable" data-challenge-unavailable data-make24-unavailable hidden>{{ unavailable }}</p>
  <noscript><p class="toy-challenge__noscript">{{ no_js }}</p></noscript>

  <script type="application/json" data-make24-copy>
    {
      "applied": {{ applied | jsonify }},
      "defaultsReady": {{ defaults_ready | jsonify }},
      "dividedByZero": {{ divided_by_zero | jsonify }},
      "locale": {{ locale | jsonify }},
      "merged": {{ merged | jsonify }},
      "newGame": {{ new_game | jsonify }},
      "poolAll": {{ pool_all | jsonify }},
      "poolCount": {{ pool_count | jsonify }},
      "poolFraction": {{ pool_fraction | jsonify }},
      "poolInteger": {{ pool_integer | jsonify }},
      "promptIdle": {{ prompt_idle | jsonify }},
      "promptOperator": {{ prompt_operator | jsonify }},
      "promptRevealed": {{ prompt_revealed | jsonify }},
      "promptRight": {{ prompt_right | jsonify }},
      "revealed": {{ revealed | jsonify }},
      "reset": {{ reset | jsonify }},
      "selectionCleared": {{ selection_cleared | jsonify }},
      "settingsSummary": {{ summary | jsonify }},
      "stuck": {{ stuck | jsonify }},
      "unavailable": {{ unavailable | jsonify }},
      "valueName": {{ value_name | jsonify }},
      "undone": {{ undone | jsonify }},
      "won": {{ won | jsonify }}
    }
  </script>
</section>
