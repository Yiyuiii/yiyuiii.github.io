<section
  class="toy-challenge toy-ten-second"
  data-toy-ten-second
  aria-label="{{ challenge_label | escape }}"
>
  <p class="toy-challenge__instructions">{{ instructions }}</p>
  <p class="toy-challenge__note">{{ local_note }}</p>

  <div class="toy-challenge__interactive" data-challenge-interactive hidden>
    <div class="toy-challenge__actions">
      <button type="button" data-ten-primary>{{ start }}</button>
      <button type="button" data-ten-restart hidden>{{ restart }}</button>
    </div>
    <p
      class="toy-challenge__status"
      data-challenge-status
      aria-live="polite"
      aria-atomic="true"
    ></p>
  </div>

  <section
    class="toy-history"
    data-challenge-history
    aria-label="{{ history_label | escape }}"
    hidden
  >
    <p class="toy-challenge__note" data-history-persistence></p>
    <p class="toy-history__empty" data-history-empty>{{ empty_history }}</p>

    <div data-history-stats hidden>
      <dl class="toy-history__stats">
        <div><dt>{{ retained_label }}</dt><dd data-history-value="retained">—</dd></div>
        <div><dt>{{ completed_label }}</dt><dd data-history-value="completed">0</dd></div>
        <div><dt>{{ best_label }}</dt><dd data-history-value="best">—</dd></div>
        <div><dt>{{ typical_label }}</dt><dd data-history-value="typical">—</dd></div>
        <div><dt>{{ tendency_label }}</dt><dd data-history-value="tendency">—</dd></div>
        <div><dt>{{ recent_label }}</dt><dd data-history-value="recent">—</dd></div>
      </dl>
      <p class="toy-challenge__note">{{ trend_note }}</p>
    </div>

    <div class="toy-history__chart" data-history-chart hidden></div>

    <details class="toy-history__records" data-history-records hidden>
      <summary>{{ records_label }}</summary>
      <div class="toy-history__table-wrap">
        <table>
          <caption class="sr-only">{{ history_label }}</caption>
          <thead>
            <tr>
              <th scope="col">{{ record_number }}</th>
              <th scope="col">{{ record_value }}</th>
              <th scope="col">{{ record_inclusion }}</th>
            </tr>
          </thead>
          <tbody data-history-table-body></tbody>
        </table>
      </div>
    </details>

    <div class="toy-history__actions">
      <button type="button" data-history-clear hidden>{{ clear_history }}</button>
      <span data-history-confirmation hidden>
        <span>{{ clear_question }}</span>
        <button type="button" data-history-confirm-clear>{{ confirm_clear }}</button>
        <button type="button" data-history-cancel-clear>{{ cancel_clear }}</button>
      </span>
    </div>
    <p data-history-clear-status aria-live="polite" aria-atomic="true"></p>
  </section>

  <p class="toy-challenge__unavailable" data-challenge-unavailable hidden>{{ unavailable }}</p>
  <noscript><p class="toy-challenge__noscript">{{ no_js }}</p></noscript>

  <script type="application/json" data-challenge-copy>
    {
      "start": {{ start | jsonify }},
      "stop": {{ stop | jsonify }},
      "again": {{ again | jsonify }},
      "restart": {{ restart | jsonify }},
      "running": {{ running | jsonify }},
      "result": {{ result | jsonify }},
      "early": {{ early | jsonify }},
      "late": {{ late | jsonify }},
      "exact": {{ exact | jsonify }},
      "cancelled": {{ cancelled | jsonify }},
      "unavailable": {{ unavailable | jsonify }},
      "persistence": {{ persistence_copy | jsonify }},
      "memoryOnly": {{ memory_only_copy | jsonify }},
      "notAvailable": {{ '—' | jsonify }},
      "secondsValue": {{ seconds_value_copy | jsonify }},
      "signedSecondsValue": {{ signed_seconds_value_copy | jsonify }},
      "exactValue": {{ exact_value_copy | jsonify }},
      "validRetainedValue": {{ valid_retained_value_copy | jsonify }},
      "chartTitle": {{ chart_title_copy | jsonify }},
      "chartDescription": {{ chart_description_copy | jsonify }},
      "older": {{ older_copy | jsonify }},
      "newer": {{ newer_copy | jsonify }},
      "tenSampleValue": {{ ten_sample_value_copy | jsonify }},
      "included": {{ included_copy | jsonify }},
      "excluded": {{ excluded_copy | jsonify }},
      "cleared": {{ cleared_copy | jsonify }},
      "clearFailed": {{ clear_failed_copy | jsonify }}
    }
  </script>
</section>
