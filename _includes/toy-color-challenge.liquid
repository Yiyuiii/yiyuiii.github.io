<section
  class="toy-challenge toy-color-challenge"
  data-toy-color-challenge
  aria-label="{{ challenge_label | escape }}"
>
  <p class="toy-challenge__instructions">{{ instructions }}</p>
  <p class="toy-challenge__note">{{ disclaimer }}</p>

  <div class="toy-challenge__interactive" data-challenge-interactive hidden>
    <details class="toy-color-settings" data-color-settings>
      <summary>
        <span class="toy-color-settings__title">{{ settings_title }}</span>
        <span class="toy-color-settings__summary" data-color-settings-summary></span>
        <span class="toy-color-settings__adjust">{{ settings_adjust }}</span>
      </summary>
      <div class="toy-color-settings__panel">
        <fieldset class="toy-fieldset toy-presets">
          <legend>{{ presets_label }}</legend>
          <button type="button" data-color-preset="all">{{ preset_all }}</button>
          <button type="button" data-color-preset="lightness">{{ preset_lightness }}</button>
          <button type="button" data-color-preset="chroma">{{ preset_chroma }}</button>
          <button type="button" data-color-preset="hue">{{ preset_hue }}</button>
        </fieldset>

        <fieldset class="toy-fieldset">
          <legend>{{ variations_label }}</legend>
          <div class="toy-checks">
            <label class="toy-check"><input type="checkbox" value="lightness" data-color-variation> {{ lightness_name }}</label>
            <label class="toy-check"><input type="checkbox" value="chroma" data-color-variation> {{ chroma_name }}</label>
            <label class="toy-check"><input type="checkbox" value="hue" data-color-variation> {{ hue_name }}</label>
          </div>
          <p class="toy-field-help">{{ variations_help }}</p>
        </fieldset>

        <fieldset class="toy-fieldset">
          <legend>{{ hue_scope_label }}</legend>
          <div class="toy-checks">
            <label class="toy-check"><input type="radio" name="color-hue-scope" value="all" data-color-hue-scope> {{ hue_scope_all }}</label>
            <label class="toy-check"><input type="radio" name="color-hue-scope" value="custom" data-color-hue-scope> {{ hue_scope_custom }}</label>
          </div>
          <div class="toy-color-settings__hues" data-color-custom-hues hidden>
            <label style="--toy-hue: 30deg"><input type="checkbox" value="0" data-color-hue-sector><span aria-hidden="true"></span>{{ red_name }}</label>
            <label style="--toy-hue: 90deg"><input type="checkbox" value="1" data-color-hue-sector><span aria-hidden="true"></span>{{ yellow_name }}</label>
            <label style="--toy-hue: 150deg"><input type="checkbox" value="2" data-color-hue-sector><span aria-hidden="true"></span>{{ green_name }}</label>
            <label style="--toy-hue: 210deg"><input type="checkbox" value="3" data-color-hue-sector><span aria-hidden="true"></span>{{ cyan_name }}</label>
            <label style="--toy-hue: 270deg"><input type="checkbox" value="4" data-color-hue-sector><span aria-hidden="true"></span>{{ blue_name }}</label>
            <label style="--toy-hue: 330deg"><input type="checkbox" value="5" data-color-hue-sector><span aria-hidden="true"></span>{{ magenta_name }}</label>
          </div>
          <p class="toy-field-help">{{ hue_help }}</p>
        </fieldset>

        <div class="toy-color-settings__neutral">
          <label class="toy-check"><input type="checkbox" data-color-neutral> {{ neutral_label }}</label>
          <p class="toy-field-help">{{ neutral_help }}</p>
        </div>

        <fieldset class="toy-fieldset">
          <legend>{{ progression_label }}</legend>
          <div class="toy-checks">
            <label class="toy-check"><input type="radio" name="color-progression" value="auto" data-color-progression> {{ progression_auto }}</label>
            <label class="toy-check"><input type="radio" name="color-progression" value="fixed" data-color-progression> {{ progression_fixed }}</label>
          </div>
          <label class="toy-color-settings__level" data-color-fixed-wrap hidden>
            <span>{{ fixed_level_label }}</span>
            <input type="range" min="1" max="25" step="1" value="9" data-color-fixed-level>
            <output data-color-fixed-output>9/25</output>
          </label>
        </fieldset>

        <p class="toy-field-help">{{ settings_notice }}</p>
        <div class="toy-color-settings__actions">
          <button type="button" data-color-reset>{{ settings_reset }}</button>
          <button type="button" data-color-apply>{{ settings_apply }}</button>
        </div>
        <p class="toy-color-settings__status" data-color-settings-status aria-live="polite" aria-atomic="true"></p>
      </div>
    </details>

    <dl class="toy-color-challenge__stats toy-color-challenge__stats--primary">
      <div><dt>{{ score_label }}</dt><dd data-color-score>0</dd></div>
      <div><dt>{{ level_stats_label }}</dt><dd data-color-level></dd></div>
      <div><dt>{{ block_label }}</dt><dd data-color-block></dd></div>
      <div><dt>{{ difference_label }}</dt><dd data-color-difference></dd></div>
    </dl>
    <details class="toy-color-challenge__more">
      <summary>{{ more_statistics_label }}</summary>
      <dl class="toy-color-challenge__stats toy-color-challenge__stats--secondary">
        <div><dt>{{ answered_label }}</dt><dd data-color-answered>0</dd></div>
        <div><dt>{{ record_label }}</dt><dd data-color-record></dd></div>
        <div><dt>{{ streak_label }}</dt><dd data-color-streak></dd></div>
        <div><dt>{{ highest_label }}</dt><dd data-color-highest></dd></div>
        <div><dt>{{ extreme_label }}</dt><dd data-color-extreme>0</dd></div>
        <div><dt>{{ foundation_label }}</dt><dd data-color-foundation>0</dd></div>
      </dl>
    </details>

    <div
      class="toy-color-challenge__grid"
      data-color-grid
      role="group"
      aria-label="{{ group_label | escape }}"
    ></div>
    <div class="toy-challenge__actions">
      <button type="button" data-color-next>{{ next_label }}</button>
    </div>
    <p
      class="toy-challenge__status"
      data-challenge-status
      aria-live="polite"
      aria-atomic="true"
    ></p>
  </div>

  <p class="toy-challenge__unavailable" data-challenge-unavailable hidden>{{ unavailable }}</p>
  <noscript><p class="toy-challenge__noscript">{{ no_js }}</p></noscript>

  <script type="application/json" data-challenge-copy>
    {
      "applied": {{ applied | jsonify }},
      "blockSettledValue": {{ block_settled_value | jsonify }},
      "blockValue": {{ block_value | jsonify }},
      "cleared": {{ cleared | jsonify }},
      "correct": {{ correct | jsonify }},
      "correctCellLabel": {{ correct_cell_label | jsonify }},
      "cellLabel": {{ cell_label | jsonify }},
      "defaultsReady": {{ defaults_ready | jsonify }},
      "extremeContinues": {{ extreme_continues | jsonify }},
      "fixedContinues": {{ fixed_continues | jsonify }},
      "foundationContinues": {{ foundation_continues | jsonify }},
      "highestValue": {{ highest_value | jsonify }},
      "hueRequired": {{ hue_required | jsonify }},
      "incorrect": {{ incorrect | jsonify }},
      "levelDown": {{ level_down | jsonify }},
      "levelUp": {{ level_up | jsonify }},
      "levelValue": {{ level_value | jsonify }},
      "notAvailable": {{ not_available | jsonify }},
      "perceptualDifference": {{ perceptual_difference | jsonify }},
      "presetReady": {{ preset_ready | jsonify }},
      "recordValue": {{ record_value | jsonify }},
      "streakValue": {{ streak_value | jsonify }},
      "summaryAllHues": {{ summary_all_hues | jsonify }},
      "summaryAuto": {{ summary_auto | jsonify }},
      "summaryComposite": {{ summary_composite | jsonify }},
      "summaryFixed": {{ summary_fixed | jsonify }},
      "summaryHueCount": {{ summary_hue_count | jsonify }},
      "summaryMixed": {{ summary_mixed | jsonify }},
      "summaryNeutralSuffix": {{ summary_neutral_suffix | jsonify }},
      "unavailable": {{ unavailable | jsonify }},
      "variationRequired": {{ variation_required | jsonify }},
      "variations": {{ variation_labels_json }},
      "zones": {{ zones_json }}
    }
  </script>
</section>
