{% assign lang_key = page.lang | default: 'zh' %}
{% if lang_key == 'zh-CN' %}{% assign lang_key = 'zh' %}{% endif %}
{% if lang_key == 'en' %}
  {% assign challenge_label = 'Find the different color' %}
  {% assign instructions = 'Each set contains three questions. Get at least two right to move up one of 25 levels; otherwise you move down. A correct answer adds one point and a wrong answer subtracts one, so the score may be negative.' %}
  {% assign disclaimer = 'The scale runs from the maximum black–white digital difference to a one-code, one-channel sRGB difference. This is a visual game, not a color-vision test or medical assessment.' %}
  {% assign group_label = 'Sixteen color tiles' %}
  {% assign cell_label = 'Tile {number}' %}
  {% assign correct_cell_label = 'Tile {number}, the different color' %}
  {% assign next_label = 'Next question' %}
  {% assign correct = 'Correct: score {score}. The different tile was {answer}.' %}
  {% assign incorrect = 'Not quite: score {score}. The different tile was {answer}.' %}
  {% assign level_up = 'The set was positive; difficulty rises to {level}/{count}.' %}
  {% assign level_down = 'The set was negative; difficulty falls to {level}/{count}.' %}
  {% assign cleared = 'All standard levels are complete; single-code endless mode begins. Extreme sets cleared: {count}.' %}
  {% assign extreme_continues = 'Single-code endless mode continues. Extreme sets cleared: {count}.' %}
  {% assign foundation_continues = 'This is already the maximum digital difference, so foundation practice continues.' %}
  {% assign unavailable = 'Secure local randomness is unavailable in this browser, so this challenge has been disabled.' %}
  {% assign no_js = 'JavaScript is required for this local challenge. No result is sent or stored.' %}
  {% assign score_label = 'Score' %}
  {% assign level_stats_label = 'Difficulty' %}
  {% assign block_label = 'Current set' %}
  {% assign difference_label = 'Current difference' %}
  {% assign more_statistics_label = 'More statistics' %}
  {% assign answered_label = 'Questions answered' %}
  {% assign record_label = 'Record' %}
  {% assign streak_label = 'Streak' %}
  {% assign highest_label = 'Highest difficulty' %}
  {% assign extreme_label = 'Extreme sets cleared' %}
  {% assign foundation_label = 'Foundation repeats' %}
  {% assign zones_json = '["digital maximum","high contrast","perceptual steps","quantization edge","single-code limit"]' %}
  {% assign level_value = '{level}/{count} · {zone}' %}
  {% assign block_value = '{answered}/3 · net {score}' %}
  {% assign block_settled_value = 'settled · net {score}' %}
  {% assign record_value = '{correct} correct · {wrong} wrong · {accuracy}' %}
  {% assign streak_value = '{current} current · {best} best' %}
  {% assign highest_value = '{level}/{count}' %}
  {% assign maximum_difference = 'RGB code distance {distance} (maximum)' %}
  {% assign perceptual_difference = 'ΔEOK {delta}, measured from final 8-bit RGB' %}
  {% assign single_code_difference = '{channel} channel {code} code · ΔEOK {delta}' %}
  {% assign not_available = '—' %}
{% else %}
  {% assign challenge_label = '找出不一样的颜色' %}
  {% assign instructions = '每三题结算一次：答对至少两题升一级，否则降一级，共 25 级。每题答对加 1 分、答错减 1 分，因此积分可以为负。' %}
  {% assign disclaimer = '难度从黑白最大数字色差延伸到 sRGB 单通道相差一个码值。这是视觉小游戏，不是色觉检查或医学评估。' %}
  {% assign group_label = '十六个色块' %}
  {% assign cell_label = '第 {number} 格' %}
  {% assign correct_cell_label = '第 {number} 格，不同的颜色' %}
  {% assign next_label = '下一题' %}
  {% assign correct = '答对，积分 {score}；不同色块是第 {answer} 格。' %}
  {% assign incorrect = '没有猜中，积分 {score}；不同色块是第 {answer} 格。' %}
  {% assign level_up = '本组三题净分为正，难度升至 {level}/{count}。' %}
  {% assign level_down = '本组三题净分为负，难度降至 {level}/{count}。' %}
  {% assign cleared = '已完成全部标准等级，进入单码极限无尽模式；极限组三题已通过 {count} 组。' %}
  {% assign extreme_continues = '继续单码极限无尽模式；极限组三题已通过 {count} 组。' %}
  {% assign foundation_continues = '当前已经是最大数字色差，将继续基础练习。' %}
  {% assign unavailable = '当前浏览器无法提供安全的本地随机源，因此这项挑战已停用。' %}
  {% assign no_js = '这项本地挑战需要 JavaScript；结果不会被发送或保存。' %}
  {% assign score_label = '积分' %}
  {% assign level_stats_label = '难度' %}
  {% assign block_label = '本组三题' %}
  {% assign difference_label = '当前色差' %}
  {% assign more_statistics_label = '更多统计' %}
  {% assign answered_label = '已答题数' %}
  {% assign record_label = '答题统计' %}
  {% assign streak_label = '连续答对' %}
  {% assign highest_label = '到达过的最高难度' %}
  {% assign extreme_label = '极限组通过数' %}
  {% assign foundation_label = '基础端重复数' %}
  {% assign zones_json = '["数字极值","高对比","感知阶梯","量化边缘","单码极限"]' %}
  {% assign level_value = '{level}/{count} · {zone}' %}
  {% assign block_value = '{answered}/3 · 净分 {score}' %}
  {% assign block_settled_value = '已结算 · 净分 {score}' %}
  {% assign record_value = '答对 {correct} · 答错 {wrong} · 正确率 {accuracy}' %}
  {% assign streak_value = '当前 {current} · 最佳 {best}' %}
  {% assign highest_value = '{level}/{count}' %}
  {% assign maximum_difference = 'RGB 码值距离 {distance}（数字最大）' %}
  {% assign perceptual_difference = 'ΔEOK {delta}（由最终 8-bit RGB 计算）' %}
  {% assign single_code_difference = '{channel} 通道 {code} 个码值 · ΔEOK {delta}' %}
  {% assign not_available = '—' %}
{% endif %}

<section
  class="toy-challenge toy-color-challenge"
  data-toy-color-challenge
  aria-label="{{ challenge_label | escape }}"
>
  <p class="toy-challenge__instructions">{{ instructions }}</p>
  <p class="toy-challenge__note">{{ disclaimer }}</p>

  <div class="toy-challenge__interactive" data-challenge-interactive hidden>
    <dl class="toy-color-challenge__stats toy-color-challenge__stats--primary">
      <div><dt>{{ score_label }}</dt><dd data-color-score>0</dd></div>
      <div><dt>{{ level_stats_label }}</dt><dd data-color-level></dd></div>
      <div><dt>{{ block_label }}</dt><dd data-color-block></dd></div>
      <div><dt>{{ difference_label }}</dt><dd data-color-difference></dd></div>
    </dl>
    <details class="toy-color-challenge__more">
      <summary>{{ more_statistics_label }}</summary>
      <dl class="toy-color-challenge__stats toy-color-challenge__stats--secondary">
        <div><dt>{{ answered_label }}</dt><dd data-color-answered>0</dd></div>
        <div><dt>{{ record_label }}</dt><dd data-color-record></dd></div>
        <div><dt>{{ streak_label }}</dt><dd data-color-streak></dd></div>
        <div><dt>{{ highest_label }}</dt><dd data-color-highest></dd></div>
        <div><dt>{{ extreme_label }}</dt><dd data-color-extreme>0</dd></div>
        <div><dt>{{ foundation_label }}</dt><dd data-color-foundation>0</dd></div>
      </dl>
    </details>

    <div
      class="toy-color-challenge__grid"
      data-color-grid
      role="group"
      aria-label="{{ group_label | escape }}"
    ></div>
    <div class="toy-challenge__actions">
      <button type="button" data-color-next>{{ next_label }}</button>
    </div>
    <p
      class="toy-challenge__status"
      data-challenge-status
      aria-live="polite"
      aria-atomic="true"
    ></p>
  </div>

  <p class="toy-challenge__unavailable" data-challenge-unavailable hidden>{{ unavailable }}</p>
  <noscript><p class="toy-challenge__noscript">{{ no_js }}</p></noscript>

  <script type="application/json" data-challenge-copy>
    {
      "blockSettledValue": {{ block_settled_value | jsonify }},
      "blockValue": {{ block_value | jsonify }},
      "channels": ["R", "G", "B"],
      "cleared": {{ cleared | jsonify }},
      "correct": {{ correct | jsonify }},
      "correctCellLabel": {{ correct_cell_label | jsonify }},
      "cellLabel": {{ cell_label | jsonify }},
      "extremeContinues": {{ extreme_continues | jsonify }},
      "foundationContinues": {{ foundation_continues | jsonify }},
      "highestValue": {{ highest_value | jsonify }},
      "incorrect": {{ incorrect | jsonify }},
      "levelDown": {{ level_down | jsonify }},
      "levelUp": {{ level_up | jsonify }},
      "levelValue": {{ level_value | jsonify }},
      "maximumDifference": {{ maximum_difference | jsonify }},
      "notAvailable": {{ not_available | jsonify }},
      "perceptualDifference": {{ perceptual_difference | jsonify }},
      "recordValue": {{ record_value | jsonify }},
      "singleCodeDifference": {{ single_code_difference | jsonify }},
      "streakValue": {{ streak_value | jsonify }},
      "unavailable": {{ unavailable | jsonify }},
      "zones": {{ zones_json }}
    }
  </script>
</section>
