  {% assign applied = 'Rules applied. A new code is ready.' %}
  {% assign preset_ready = 'Preset loaded. Apply it to start a new game.' %}
  {% assign defaults_ready = 'Defaults restored in the panel. Apply them to start a new game.' %}
