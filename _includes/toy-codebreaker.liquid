<section
  class="toy-challenge toy-codebreaker"
  data-toy-codebreaker
  aria-label="{{ challenge_label | escape }}"
>
  <p class="toy-challenge__instructions">{{ instructions }}</p>
  <p class="toy-challenge__note">{{ disclaimer }}</p>

  <div class="toy-challenge__interactive" data-challenge-interactive data-code-interactive hidden>
    <details class="toy-settings toy-codebreaker-settings" data-code-settings>
      <summary>
        <span class="toy-settings__title">{{ settings_title }}</span>
        <span class="toy-settings__summary" data-code-settings-summary></span>
        <span class="toy-settings__adjust">{{ settings_adjust }}</span>
      </summary>
      <div class="toy-settings__panel">
        <fieldset class="toy-fieldset toy-presets">
          <legend>{{ presets_label }}</legend>
          <button type="button" data-code-preset="beginner">{{ preset_beginner }}</button>
          <button type="button" data-code-preset="standard">{{ preset_standard }}</button>
          <button type="button" data-code-preset="duplicates">{{ preset_duplicates }}</button>
        </fieldset>

        <div class="toy-codebreaker-settings__fields">
          <label>
            <span>{{ length_label }}</span>
            <select data-code-length>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6">6</option>
            </select>
          </label>
          <label>
            <span>{{ attempts_label }}</span>
            <select data-code-attempts>
              <option value="6">6</option>
              <option value="8">8</option>
              <option value="10">10</option>
              <option value="12">12</option>
            </select>
          </label>
          <label class="toy-check toy-codebreaker-settings__duplicates">
            <input type="checkbox" data-code-duplicates>
            <span>{{ duplicates_label }}</span>
          </label>
        </div>

        <p class="toy-codebreaker-settings__candidates">
          <span>{{ candidates_label }}</span>
          <output data-code-candidates></output>
        </p>
        <p class="toy-field-help">{{ settings_notice }}</p>
        <div class="toy-settings__actions">
          <button type="button" data-code-reset>{{ settings_reset }}</button>
          <button type="button" class="toy-settings__apply" data-code-apply>{{ settings_apply }}</button>
        </div>
        <p class="toy-settings__status" data-code-settings-status aria-live="polite" aria-atomic="true"></p>
      </div>
    </details>

    <dl class="toy-codebreaker__stats">
      <div><dt>{{ attempts_used_label }}</dt><dd data-code-attempts-used></dd></div>
      <div><dt>{{ remaining_label }}</dt><dd data-code-remaining></dd></div>
    </dl>

    <form class="toy-codebreaker__form" data-code-form novalidate>
      <label for="codebreaker-guess">{{ input_label }}</label>
      <div class="toy-codebreaker__input-row">
        <input
          id="codebreaker-guess"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          aria-describedby="codebreaker-guess-help"
          data-code-input
        >
        <button type="submit" data-code-submit>{{ submit_label }}</button>
      </div>
      <p id="codebreaker-guess-help" class="toy-field-help" data-code-input-help></p>
    </form>

    <div class="toy-codebreaker__history" data-code-history hidden>
      <div class="toy-codebreaker__table-wrap">
        <table>
          <caption class="sr-only">{{ history_caption }}</caption>
          <thead>
            <tr>
              <th scope="col">{{ history_attempt }}</th>
              <th scope="col">{{ history_guess }}</th>
              <th scope="col" title="{{ exact_explanation | escape }}">
                <span aria-hidden="true">{{ history_exact }}</span>
                <span class="sr-only">{{ exact_explanation }}</span>
              </th>
              <th scope="col" title="{{ misplaced_explanation | escape }}">
                <span aria-hidden="true">{{ history_misplaced }}</span>
                <span class="sr-only">{{ misplaced_explanation }}</span>
              </th>
            </tr>
          </thead>
          <tbody data-code-history-body></tbody>
        </table>
      </div>
    </div>

    <div class="toy-challenge__actions">
      <button type="button" data-code-new>{{ new_label }}</button>
    </div>
    <p class="toy-challenge__status" data-code-status aria-live="polite" aria-atomic="true"></p>
  </div>

  <p class="toy-challenge__unavailable" data-challenge-unavailable data-code-unavailable hidden>{{ unavailable }}</p>
  <noscript><p class="toy-challenge__noscript">{{ no_js }}</p></noscript>

  <script type="application/json" data-code-copy>
    {
      "applied": {{ applied | jsonify }},
      "attemptsValue": {{ attempts_value | jsonify }},
      "candidateValue": {{ candidate_value | jsonify }},
      "defaultsReady": {{ defaults_ready | jsonify }},
      "duplicatesAllowed": {{ duplicates_allowed | jsonify }},
      "duplicatesDisallowed": {{ duplicates_disallowed | jsonify }},
      "feedback": {{ feedback | jsonify }},
      "inputHelp": {{ input_help | jsonify }},
      "invalidDigits": {{ invalid_digits | jsonify }},
      "invalidDuplicates": {{ invalid_duplicates | jsonify }},
      "locale": {{ locale | jsonify }},
      "lost": {{ lost | jsonify }},
      "newGame": {{ new_game | jsonify }},
      "presetReady": {{ preset_ready | jsonify }},
      "settingsSummary": {{ settings_summary | jsonify }},
      "uniqueSuffix": {{ unique_suffix | jsonify }},
      "unavailable": {{ unavailable | jsonify }},
      "won": {{ won | jsonify }}
    }
  </script>
</section>
