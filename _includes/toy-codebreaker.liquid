  {% assign instructions = '猜出隐藏的数字码。每次提交后，只会告诉你有几个数字和位置都正确，以及有几个数字正确但位置不对。' %}
  {% assign disclaimer = '答案、设置和本局记录只保留在当前页面内存中，不会发送或保存；结果也不是智力或逻辑能力评估。' %}
  {% assign settings_title = '玩法规则' %}
  {% assign settings_adjust = '调整' %}
  {% assign presets_label = '快捷预设' %}
  {% assign preset_beginner = '入门' %}
  {% assign preset_standard = '标准' %}
  {% assign preset_duplicates = '可重复' %}
  {% assign length_label = '数字码长度' %}
  {% assign attempts_label = '作答机会' %}
  {% assign duplicates_label = '允许数字重复' %}
  {% assign candidates_label = '当前候选范围' %}
  {% assign candidate_value = '{count} 个可能答案' %}
  {% assign settings_notice = '调整只会在点击应用后生效；应用会清空当前这一局。' %}
  {% assign settings_reset = '恢复默认' %}
  {% assign settings_apply = '应用并开始新一局' %}
  {% assign input_label = '你的猜测' %}
  {% assign input_help = '请输入 {length} 位数字{unique}。' %}
  {% assign unique_suffix = '，不要重复' %}
  {% assign submit_label = '提交猜测' %}
  {% assign new_label = '换一个答案' %}
  {% assign attempts_used_label = '已用机会' %}
  {% assign remaining_label = '剩余机会' %}
  {% assign history_caption = '本局猜测记录' %}
  {% assign history_attempt = '次数' %}
  {% assign history_guess = '猜测' %}
  {% assign history_exact = '位置正确' %}
  {% assign history_misplaced = '数字正确' %}
  {% assign exact_explanation = '数字和位置都正确' %}
  {% assign misplaced_explanation = '数字正确但位置不对' %}
  {% assign invalid_digits = '请输入恰好 {length} 位 0 到 9 的数字。' %}
  {% assign invalid_duplicates = '当前规则下，每个数字最多使用一次。' %}
  {% assign feedback = '{guess}：位置正确 {exact} 个，数字正确 {misplaced} 个；还剩 {remaining} 次。' %}
  {% assign won = '答对了，数字码是 {secret}；共使用 {attempts} 次。' %}
  {% assign lost = '机会已经用完，数字码是 {secret}。' %}
  {% assign new_game = '新的数字码已经准备好。' %}
  {% assign applied = '规则已应用，新的数字码已经准备好。' %}
  {% assign preset_ready = '预设已填入；应用后会开始新一局。' %}
  {% assign defaults_ready = '默认设置已填入；应用后会开始新一局。' %}
  {% assign duplicates_allowed = '允许重复' %}
  {% assign duplicates_disallowed = '不重复' %}
  {% assign settings_summary = '{length} 位 · {duplicates} · {attempts} 次 · {candidates} 种组合' %}
  {% assign attempts_value = '{used}/{total}' %}
  {% assign unavailable = '当前浏览器无法提供安全的本地随机源，因此这项游戏已停用。' %}
  {% assign no_js = '这项本地游戏需要 JavaScript；不会发送或保存任何内容。' %}
  {% assign locale = 'zh-CN' %}
