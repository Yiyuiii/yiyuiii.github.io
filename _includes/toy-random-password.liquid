{% assign lang_key = page.lang | default: 'zh' %}
{% if lang_key == 'zh-CN' %}{% assign lang_key = 'zh' %}{% endif %}
{% assign copy = site.data.toy_generators.password[lang_key] | default: site.data.toy_generators.password.zh %}

<form class="toy-tool toy-password" data-toy-random-password>
  <div data-generator-interactive hidden>
    <p class="toy-tool__note">{{ copy.local_note }}</p>

    <div class="toy-form-field">
      <label for="random-password-length">{{ copy.length_label }}</label>
      <input id="random-password-length" data-password-length type="number" min="8" max="128" step="1" value="20" inputmode="numeric" aria-describedby="random-password-length-help">
      <p id="random-password-length-help" class="toy-field-help">{{ copy.length_help }}</p>
    </div>

    <fieldset class="toy-fieldset">
      <legend>{{ copy.groups_label }}</legend>
      <label><input data-password-group="lowercase" type="checkbox" checked> {{ copy.lowercase }}</label>
      <label><input data-password-group="uppercase" type="checkbox" checked> {{ copy.uppercase }}</label>
      <label><input data-password-group="digits" type="checkbox" checked> {{ copy.digits }}</label>
      <label><input data-password-group="symbols" type="checkbox" checked> {{ copy.symbols }}</label>
    </fieldset>

    <label class="toy-check"><input data-password-ambiguous type="checkbox" checked> {{ copy.exclude_ambiguous }}</label>

    <div class="toy-actions">
      <button type="submit" data-password-generate>{{ copy.generate }}</button>
    </div>

    <div class="toy-output" data-password-output-wrap hidden>
      <label for="random-password-output">{{ copy.output_label }}</label>
      <input id="random-password-output" data-password-output type="password" readonly spellcheck="false" autocomplete="off">
      <div class="toy-actions toy-actions--secondary">
        <button type="button" data-password-visibility>{{ copy.show }}</button>
        <button type="button" data-password-copy>{{ copy.copy }}</button>
      </div>
    </div>

    <p class="toy-status" data-password-status aria-live="polite" aria-atomic="true"></p>
  </div>
  <noscript><p class="toy-noscript">{{ copy.no_js }}</p></noscript>
  <script type="application/json" data-password-copy-data>{{ copy | jsonify }}</script>
</form>
