{% assign lang_key = page.lang | default: 'zh' %}
{% if lang_key == 'zh-CN' %}{% assign lang_key = 'zh' %}{% endif %}
{% assign toys = site.data.toys %}
{% assign copy = toys.page[lang_key] %}

<div
  class="toy-index"
  data-toy-index
  data-toy-loading="{{ copy.loading | escape }}"
  data-toy-load-error="{{ copy.load_error | escape }}"
>
  <header class="toy-index__header">
    <h1 class="sr-only">{{ page.title }}</h1>
    <p class="toy-index__introduction">{{ copy.introduction }}</p>
  </header>

  <div class="toy-list">
    {% for group in toys.groups %}
      {% assign group_title = nil %}
      {% if group.title %}{% assign group_title = group.title[lang_key] %}{% endif %}
      <section
        class="toy-group{% unless group_title %} toy-group--ungrouped{% endunless %}"
        data-toy-group="{{ group.id | escape }}"
        {% if group_title %}aria-labelledby="toy-group-{{ group.id | escape }}-title"{% endif %}
      >
        {% if group_title %}
          <h2 id="toy-group-{{ group.id | escape }}-title" class="toy-group__title">{{ group_title }}</h2>
        {% endif %}

        <div class="toy-group__items">
          {% for toy in group.items %}
            {% capture toy_title_id %}{{ toy.id }}-title{% endcapture %}
            {% if toy.external_url %}
              <a
                id="{{ toy.id | escape }}"
                class="toy-entry toy-entry--external"
                href="{{ toy.external_url | escape }}"
                target="_blank"
                rel="external noopener noreferrer"
              >
                {% if group_title %}
                  <h3 id="{{ toy_title_id }}">
                {% else %}
                  <h2 id="{{ toy_title_id }}">
                {% endif %}
                    <span class="toy-entry__title">{{ toy.title[lang_key] }}</span>
                    <small class="toy-entry__description">{{ toy.description[lang_key] }}</small>
                    <small class="toy-entry__external-label">{{ toy.external_label[lang_key] }} <span aria-hidden="true">↗</span></small>
                {% if group_title %}</h3>{% else %}</h2>{% endif %}
              </a>
            {% else %}
            {% assign toy_assets = '' %}
            {% case toy.id %}
              {% when 'moegirl-quiz' %}{% assign toy_assets = 'moegirl' %}
              {% when 'art-glimpse' %}{% assign toy_assets = 'art' %}
              {% when 'anilist-role-quiz' %}{% assign toy_assets = 'acg-logic acg-ui' %}
              {% when 'color-challenge' %}{% assign toy_assets = 'random color' %}
              {% when 'ten-second' or 'reaction-time' %}{% assign toy_assets = 'random history challenges' %}
              {% when 'codebreaker' %}{% assign toy_assets = 'random codebreaker' %}
              {% when 'make-24' %}{% assign toy_assets = 'random make24' %}
              {% when 'lights-out' %}{% assign toy_assets = 'random lights' %}
              {% when 'random-password' or 'random-number' %}{% assign toy_assets = 'random generators' %}
            {% endcase %}
            <details
              id="{{ toy.id | escape }}"
              class="toy-entry"
              data-toy-disclosure
              data-toy-assets="{{ toy_assets }}"
            >
              <summary class="toy-entry__summary">
                {% if group_title %}
                  <h3 id="{{ toy_title_id }}">
                {% else %}
                  <h2 id="{{ toy_title_id }}">
                {% endif %}
                    <span class="toy-entry__title">{{ toy.title[lang_key] }}</span>
                    <small class="toy-entry__description">{{ toy.description[lang_key] }}</small>
                {% if group_title %}</h3>{% else %}</h2>{% endif %}
              </summary>
              <div class="toy-entry__body" aria-labelledby="{{ toy_title_id }}">
                <div class="toy-loader-status" data-toy-loader-status role="status" aria-live="polite" hidden>
                  <span data-toy-loader-message>{{ copy.loading }}</span>
                  <button type="button" data-toy-loader-retry hidden>{{ copy.retry }}</button>
                </div>
                {% case toy.id %}
                  {% when 'moegirl-quiz' %}
                    {%- comment -%}保留 moegirl-quiz 作为公开片段兼容 ID；可见标题按唯一题源称“萌娘百科猜猜”。{%- endcomment -%}
                    {% include toy-moegirl-quiz.liquid heading_id=toy_title_id %}
                  {% when 'art-glimpse' %}
                    {% include toy-art-glimpse.liquid heading_id=toy_title_id %}
                  {% when 'anilist-role-quiz' %}
                    {% include toy-acg-relation-quiz.liquid heading_id=toy_title_id %}
                  {% when 'color-challenge' %}
                    {% include toy-color-challenge.liquid %}
                  {% when 'ten-second' %}
                    {% include toy-ten-second.liquid %}
                  {% when 'reaction-time' %}
                    {% include toy-reaction-time.liquid %}
                  {% when 'codebreaker' %}
                    {% include toy-codebreaker.liquid %}
                  {% when 'make-24' %}
                    {% include toy-make-24.liquid %}
                  {% when 'lights-out' %}
                    {% include toy-lights-out.liquid %}
                  {% when 'random-password' %}
                    {% include toy-random-password.liquid %}
                  {% when 'random-number' %}
                    {% include toy-random-number.liquid %}
                {% endcase %}
              </div>
            </details>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>

  <script type="application/json" data-toy-asset-manifest>
    {
      "random": {{ '/assets/js/toy-random.js' | relative_url | bust_file_cache | jsonify }},
      "generators": {{ '/assets/js/toy-generators.js' | relative_url | bust_file_cache | jsonify }},
      "history": {{ '/assets/js/toy-challenge-history.js' | relative_url | bust_file_cache | jsonify }},
      "challenges": {{ '/assets/js/toy-challenges.js' | relative_url | bust_file_cache | jsonify }},
      "color": {{ '/assets/js/toy-color-challenge.js' | relative_url | bust_file_cache | jsonify }},
      "codebreaker": {{ '/assets/js/toy-codebreaker.js' | relative_url | bust_file_cache | jsonify }},
      "make24": {{ '/assets/js/toy-make-24.js' | relative_url | bust_file_cache | jsonify }},
      "lights": {{ '/assets/js/toy-lights-out.js' | relative_url | bust_file_cache | jsonify }},
      "moegirl": {{ '/assets/js/moegirl-quiz.js' | relative_url | bust_file_cache | jsonify }},
      "art": {{ '/assets/js/art-glimpse.js' | relative_url | bust_file_cache | jsonify }},
      "acg-logic": {{ '/assets/js/acg-relation-quiz-logic.js' | relative_url | bust_file_cache | jsonify }},
      "acg-ui": {{ '/assets/js/acg-relation-quiz.js' | relative_url | bust_file_cache | jsonify }}
    }
  </script>
  <script src="{{ '/assets/js/toy-loader.js' | relative_url | bust_file_cache }}" defer></script>
</div>
