{% if page.math != false %}
  {% if page.pseudocode or page.tikzjax %}
    {% al_math_scripts %}
  {% elsif page.math == true %}
    <script src="{{ '/assets/al_math/js/mathjax-setup.js' | relative_url }}"></script>
    <script
      defer
      src="{{ '/assets/js/mathjax-loader.js' | relative_url | bust_file_cache }}"
      data-runtime-src="{{ site.third_party_libraries.mathjax.url.js | relative_url | escape }}"
      data-runtime-integrity="{{ site.third_party_libraries.mathjax.integrity.js | escape }}"
      data-font-url="{{ site.third_party_libraries.mathjax.url.fonts | relative_url | escape }}"
    ></script>
  {% endif %}
{% endif %}
